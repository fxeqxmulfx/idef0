{
  "name": "idef0-dsl",
  "version": "0.1.0",
  "description": "A text DSL for IDEF0 function models, compiled to PDF",
  "type": "module",
  "bin": {
    "idef0": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "npm run typecheck && node --test 'test/**/*.test.ts'",
    "idef0": "node src/cli.ts",
    "web": "vite web",
    "web:build": "vite build web",
    "web:preview": "vite preview web"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "dependencies": {
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "codemirror": "^6.0.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
